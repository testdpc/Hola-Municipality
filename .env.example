# Development environment example for HMIMS
# Copy this file to .env.development and fill with real values when necessary.

# Vite dev server port
PORT=23568
# Base path for the app (used for Vite base config)
BASE_PATH=/

# Node environment
NODE_ENV=development

# Replit runtime ID (optional)
# REPL_ID=

# Database (Postgres) URL — required by drizzle/db if running server or migrations.
# Example: postgresql://user:password@localhost:5432/hmims_dev
DATABASE_URL=

# Session secret for API JWTs — code defaults to 'hmims-secret-key' if not set.
SESSION_SECRET=

# Log level
LOG_LEVEL=info
